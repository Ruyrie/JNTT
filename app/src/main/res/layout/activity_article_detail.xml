<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F7"
    android:fitsSystemWindows="true">

    <!-- ── Toolbar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="22sp"
            android:textColor="#1F1F1F"
            android:padding="16dp" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1F1F1F"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginEnd="8dp"
            android:text="" />

        <TextView
            android:id="@+id/tvDeleteBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="删除"
            android:textSize="15sp"
            android:textColor="#E53935"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ── Scrollable content ── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cover image (hidden when no coverUri) -->
            <ImageView
                android:id="@+id/ivDetailCover"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Article content block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="16dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_marginBottom="14dp"
                    android:text="标题" />

                <!-- Author row (avatar + name + time + follow button) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="10dp">
                        
                        <ImageView
                            android:id="@+id/ivDetailAuthorAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="@drawable/bg_auth_logo"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvDetailAuthorInitial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:background="@drawable/bg_auth_logo" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDetailAuthor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1F1F1F"
                            android:text="作者" />

                        <TextView
                            android:id="@+id/tvDetailTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="#AAAAAA"
                            android:layout_marginTop="2dp"
                            android:text="时间" />
                    </LinearLayout>

                    <!-- Follow / unfollow button -->
                    <TextView
                        android:id="@+id/tvFollowBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ 关注"
                        android:textSize="12sp"
                        android:textColor="#2F80ED"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/bg_auth_input"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginBottom="14dp" />

                <!-- Article body -->
                <TextView
                    android:id="@+id/tvDetailContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:lineSpacingMultiplier="1.7"
                    android:text="正文内容" />

                <!-- Read count (bottom of content block) -->
                <TextView
                    android:id="@+id/tvDetailReadCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#BBBBBB"
                    android:layout_marginTop="16dp"
                    android:text="阅读 0" />
            </LinearLayout>

            <!-- ── Comments section ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_marginTop="8dp">

                <!-- Header: "评论 N条" -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="评论"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1F1F1F" />

                    <TextView
                        android:id="@+id/tvCommentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#AAAAAA"
                        android:layout_marginStart="8dp"
                        android:text="0 条" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#F0F0F0" />

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/llNoComments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="36dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="还没有评论，快来说点什么吧 ～"
                        android:textSize="14sp"
                        android:textColor="#BBBBBB" />
                </LinearLayout>

                <!-- Comments RecyclerView (nested scroll disabled) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvComments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <!-- Bottom padding so last comment isn't hidden under the bar -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Fixed bottom action bar ── -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- Comment input (rounded pill, XHS style) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_bar"
            android:paddingHorizontal="14dp"
            android:layout_marginEnd="10dp">

            <EditText
                android:id="@+id/etComment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="说点什么..."
                android:textColorHint="#AAAAAA"
                android:textSize="14sp"
                android:textColor="#1F1F1F"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Like button (heart + count) -->
        <LinearLayout
            android:id="@+id/layoutLike"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="44dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <TextView
                android:id="@+id/tvLikeBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♡"
                android:textSize="22sp"
                android:textColor="#AAAAAA"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#AAAAAA"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:text="0" />
        </LinearLayout>

        <!-- Comment count icon -->
        <LinearLayout
            android:id="@+id/layoutCommentIcon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="44dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="18sp"
                android:textColor="#AAAAAA"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvCommentCountBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#AAAAAA"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:text="0" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
