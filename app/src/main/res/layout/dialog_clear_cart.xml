<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_clear_dialog"
    android:paddingStart="22dp"
    android:paddingTop="24dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#F04142"
        android:includeFontPadding="false"
        android:background="@drawable/bg_clear_icon" />

    <TextView
        android:id="@+id/tvClearTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="清空购物车"
        android:textColor="#1F1F1F"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvClearMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="将移除当前商品，退出后也不会恢复。"
        android:textColor="#666666"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnClearCancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_clear_cancel"
            android:gravity="center"
            android:text="再想想"
            android:textColor="#666666"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnClearConfirm"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_clear_confirm"
            android:gravity="center"
            android:text="确认清空"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
