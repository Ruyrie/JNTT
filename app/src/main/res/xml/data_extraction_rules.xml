<?xml version="1.0" encoding="utf-8"?>
<!--
  资源文件：data_extraction_rules.xml
  项目职责：配置 Android 12 及以上版本的数据提取规则，包括云备份和设备迁移。
  使用技术：data-extraction-rules 根节点下可以声明 cloud-backup 与 device-transfer。
  配合代码：AndroidManifest.xml 通过 android:dataExtractionRules 引用本文件。
  注意：当前示例规则保持注释状态，不会改变现有备份/迁移行为。
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
          模板示例：需要控制云备份范围时，可以取消下面 include/exclude 的注释并填写路径。
          <include domain="sharedpref" path="."/>
          <exclude domain="sharedpref" path="device.xml"/>
        -->
    </cloud-backup>
    <!--
      模板示例：需要控制设备迁移范围时，可以启用 device-transfer。
      <device-transfer>
          <include domain="sharedpref" path="."/>
          <exclude domain="sharedpref" path="device.xml"/>
      </device-transfer>
    -->
</data-extraction-rules>
