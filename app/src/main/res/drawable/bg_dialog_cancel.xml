<?xml version="1.0" encoding="utf-8"?>
<!--
  资源文件：bg_dialog_cancel.xml
  项目职责：bg_dialog_cancel.xml drawable 资源，负责提供按钮背景、图标、占位图或状态效果。
  配合代码：配合布局里的 android:background/android:src 使用，也可在 Java 中通过 R.drawable 引用。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#F0F0F0" />
            <stroke android:width="1.5dp" android:color="#BBBBBB" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="#CCCCCC" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
